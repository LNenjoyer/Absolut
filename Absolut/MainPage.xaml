<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Absolut.MainPage">
    <AbsoluteLayout>
        <Image Source="tlo.png"
               Aspect="Fill"
               AbsoluteLayout.LayoutBounds="0, 0, 1, 1" 
                AbsoluteLayout.LayoutFlags="All" />

        <Label Text="Relax" TextColor="#33353a"
               FontSize="30"
                Margin="0,20,0,0"
                AbsoluteLayout.LayoutBounds="0.5, 0" 
                AbsoluteLayout.LayoutFlags="PositionProportional"/>
        <BoxView Color="#33353a" 
                 Opacity="50"
                 AbsoluteLayout.LayoutBounds="0, 1, 1, 100" 
                 AbsoluteLayout.LayoutFlags="PositionProportional, WidthProportional" />
        <StackLayout Padding="30,0"
                AbsoluteLayout.LayoutBounds="0, 1, 1, 100" 
                AbsoluteLayout.LayoutFlags="PositionProportional, WidthProportional">
            <Label FontSize="15" HorizontalOptions="Center" Text="Profile"/>
            <Label FontSize="15" HorizontalOptions="CenterAndExpand" Text="Meditate"/>
            <Label FontSize="15" HorizontalOptions="Center" Text="Themes"/>
        </StackLayout>

    </AbsoluteLayout>
</ContentPage>
