<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Absolut.MainPage">
    <AbsoluteLayout>
        <!-- Tło wypełniające całą stronę -->
        <BoxView Color="White" 
         AbsoluteLayout.LayoutBounds="0, 0, 1, 1" 
         AbsoluteLayout.LayoutFlags="All" />
        <BoxView Color="#f7f7f7" 
                 AbsoluteLayout.LayoutBounds="0, 0, 1, 0.33" 
                 AbsoluteLayout.LayoutFlags="All" />

        <Label Text="$11.95" TextColor="#33353a" FontSize="60" FontAttributes="Bold"
                AbsoluteLayout.LayoutBounds="0.5, 0.05" 
                AbsoluteLayout.LayoutFlags="PositionProportional"/>

        <Button Text="Buy Now" 
                BackgroundColor="#1695A3" 
                CornerRadius="15"
                HeightRequest="30"
                FontSize="15"
                FontAttributes="Bold"
                AbsoluteLayout.LayoutBounds="0.5, 0.17" 
                AbsoluteLayout.LayoutFlags="PositionProportional" />
        <Label Text="Why pay for credit" TextColor="#33353a" FontSize="15" FontAttributes="Bold"
                AbsoluteLayout.LayoutBounds="0.5, 0.4" 
                AbsoluteLayout.LayoutFlags="PositionProportional"/>
        <Label TextColor="#33353a" FontSize="13" FontAttributes="Bold"
        AbsoluteLayout.LayoutBounds="0.5, 0.5" 
        AbsoluteLayout.LayoutFlags="PositionProportional"
               HorizontalTextAlignment="Center">
Because you can reach people who aren't on
SkyApp by calling mobile and landline
numbers, or spending SMS, at low-cost rates.
        </Label>
    </AbsoluteLayout>
</ContentPage>
